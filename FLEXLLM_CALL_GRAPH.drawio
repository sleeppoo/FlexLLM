        <mxCell id="d-soft" value="dec_Softmax_MHA&#xa;→ dec_MHA_Softmax&#xa;dec_quant_layer_sfm_a_fp32_int8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="d1"><mxGeometry x="1740" y="510" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="d-v" value="V path&#xa;dec_V_cache_buffer&#xa;dec_V_cache_manager ×8&#xa;dec_MHA_i8xi8_axv&#xa;→ dec_MHA_i8xi8_axv_template&#xa;dec_dequant_layer_o_int_fp32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="d1"><mxGeometry x="2170" y="650" width="420" height="200" as="geometry"/></mxCell>
        <mxCell id="d-res" value="Attention residual&#xa;dec_residual_layer_input_merger&#xa;dec_residual_layer&#xa;dec_residual_layer_output_distributor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="d1"><mxGeometry x="1700" y="720" width="400" height="140" as="geometry"/></mxCell>
        <mxCell id="d-ffn" value="FFN&#xa;dec_Swish_Layer_FFN → dec_Swish&#xa;dec_Gate_layer_FFN → dec_Gate_Layer_fp32xfp32&#xa;dec_FHT_R4 → dec_FHT&#xa;down projection回到共享linear engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="d1"><mxGeometry x="1200" y="700" width="420" height="180" as="geometry"/></mxCell>
        <mxCell id="d-out" value="block/lm_head输出&#xa;dec_block_output_broadcastor&#xa;dec_Top_K_Sampling_Embedding_Layer&#xa;→ dec_Sampling_Embedding_Layer&#xa;sampled token + new embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="d1"><mxGeometry x="720" y="700" width="390" height="180" as="geometry"/></mxCell>
        <mxCell id="d-ll" value="Linear_Layer.h 下钻&#xa;dec_Linear_Layer_i4xi4&lt;BP=16,WP=64&gt;&#xa;→ systolic_array_i4xi4_pack_1x2_1D&lt;64&gt;&#xa;→ 32 × PE_i4xi4_pack_1x2_1D&#xa;每PE每周期：1×INT4 A，2×INT4 W&#xa;输出2个21-bit点积（K最大8192）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="1120" y="1020" width="510" height="230" as="geometry"/></mxCell>
        <mxCell id="d-mhape" value="MHA.h 下钻&#xa;systolic_array_i8xi8_pack_1x2_1D&lt;K/V=32&gt;&#xa;→ 16 × PE_i8xi8_pack_1x2_1xDSP_1D&#xa;每PE每周期：1×INT8 A，2×INT8 B&#xa;QK累加宽度 log2(64)+16=22&#xa;AV累加宽度 log2(MAX_SUM_SEQ_LEN)+16=27" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="1770" y="1020" width="510" height="230" as="geometry"/></mxCell>
